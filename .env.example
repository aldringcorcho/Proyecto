# Copia este archivo como .env.local y rellena los valores.
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_: solo las lee el servidor.

# URL del proyecto: Supabase → Project Settings → API (también se acepta NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=
# Clave secreta (sb_secret_...): Supabase → Project Settings → API Keys.
# Ignora RLS: NUNCA la expongas en el navegador ni la subas al repositorio.
SUPABASE_SECRET_KEY=

# Sin autenticación, la carga solo está habilitada en desarrollo (next dev).
# Ponerla a true habilita la escritura en producción para CUALQUIER visitante.
# ETL_PERMITIR_CARGA=false
